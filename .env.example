# ========================================================
# Diário de Engenharia: IA & Coding Agents - Configurações
# Copie este arquivo para .env e preencha suas credenciais
# ========================================================

# Chave de API da OpenAI para geração do resumo (gpt-6-luna / gpt-4o)
OPENAI_API_KEY="sua_chave_openai_aqui"

# Sessão do X (Twitter) - Obtenha inspecionando os Cookies em x.com
TWITTER_AUTH_TOKEN="seu_auth_token_do_x_aqui"
TWITTER_CT0="seu_ct0_do_x_aqui"

# Envio de E-mail via Gmail (SMTP SSL)
GMAIL_USER="seu_email@gmail.com"
GMAIL_APP_PASSWORD="sua_senha_de_app_gerada_no_google"
GMAIL_TO="destinatario@dominio.com.br"
